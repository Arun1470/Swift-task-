struct Student {
    var name: String
    var rollNumber: Int
    var marks: Int
}
let s1 = Student(name: "Arun", rollNumber: 101, marks: 85)
let s2 = Student(name: "Priya", rollNumber: 102, marks: 92)
print("Student 1")
print("Name:", s1.name)
print("Roll Number:", s1.rollNumber)
print("Marks:", s1.marks)
print("Student 2")
print("Name:", s2.name)
print("Roll Number:", s2.rollNumber)
print("Marks:", s2.marks)
