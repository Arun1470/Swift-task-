// Task 2.2: Append, insert and remove items from an array of favourite fruits.
var fruits = ["Mango", "Apple", "Banana", "Orange", "Grapes"]
print("Original:", fruits)

fruits.append("Pineapple")
print("After append:", fruits)

fruits.insert("Strawberry", at: 0)
print("After insert at index 0:", fruits)

if let index = fruits.firstIndex(of: "Banana") {
    fruits.remove(at: index)
}
print("After removing Banana:", fruits)
