// Task 2.5: A Set stores unique values and removes duplicates.
let values = [1, 2, 2, 3, 4, 4, 4, 5]
let uniqueValues = Set(values)

print("Original array:", values)
print("Set:", uniqueValues)
print("Original count:", values.count)
print("Set count:", uniqueValues.count)
print("Duplicates removed:", uniqueValues.count < values.count)
