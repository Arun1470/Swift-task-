struct Student {
    var name: String
}
class Person {
    var name: String

    init(name: String) {
        self.name = name
    }
}
var s1 = Student(name: "Arun")
var s2 = s1
s2.name = "Priya"
print("Original struct:", s1.name)
print("Copied struct:", s2.name)
var p1 = Person(name: "Arun")
var p2 = p1
p2.name = "Priya"
print("Original class:", p1.name)
print("Copied class:", p2.name)
