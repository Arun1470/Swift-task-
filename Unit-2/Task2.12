// Task 2.12: Set union, intersection, subtracting and symmetric difference.
let firstSet: Set<Int> = [1, 2, 3, 4]
let secondSet: Set<Int> = [3, 4, 5, 6]

print("Union:", firstSet.union(secondSet).sorted())
print("Intersection:", firstSet.intersection(secondSet).sorted())
print("First subtracting second:", firstSet.subtracting(secondSet).sorted())
print("Symmetric difference:", firstSet.symmetricDifference(secondSet).sorted())
